{ http://progopedia.com/language/false/ }
{ https://strlen.com/false-language/ }
{ https://esolangs.org/wiki/FALSE }

{ 读函数 }
[
  0
  [
    ^ $ $ '9 > '0 @ > | ~
  ]
  [
    '0 - \ 10 * +
  ] #
  %
] n:

n;! k:

{ 循环读取 k 个数组元素压入栈中 }
k; i:
[ i; 0 > ]
[
  n;!
  i; 1 - i:
] #


k; i:
0 f:

{ 遍历计算并输出相邻元素之和 }
[ i; 0 > ]
[
  { 判断是否为首元素 (i == k) }
  i; k; = f:
  
  { 如果是首元素则多复制一份，否则读取对应偏移位置的元素 }
  f; [ $ ] ?
  f; ~ [ i; O ] ?
  i; O
  
  { 求和输出 }
  +
  . " "
  
  { i = i - 1 }
  i; 1 - i:
] #

{ 循环清理栈中残留的 k 个数组元素 }
k; i:
[ i; 0 > ]
[
  %
  i; 1 - i:
] #