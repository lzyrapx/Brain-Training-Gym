{ http://progopedia.com/language/false/ }
{ https://strlen.com/false-language/ }
{ https://esolangs.org/wiki/FALSE }

[
  { 读取字符，直到遇到换行符 (ASCII 10) }
  [
    ^ $ 10 = ~
  ]
  [
    { 判断当前字符是否为 '6' }
    '6 = $
    [
      \ 1+ \     { 是 '6'，连续计数器 +1 }
    ] ?
    ~
    [
      % 0        { 不是 '6'，连续计数器清零 }
    ] ?
    
    { 检查数量是否达到 3 }
    $ 3 =
    [
      % % 1 0    { 达到 3, 找到标记设为 1，重置计数器 }
    ] ?
  ] #
] w:

{ main 入口 }
0 0 w;!  { 初始化 (计数器=0, 标记=0) 执行函数 w }

% %
1 = $
[ "YES" ] ?
~
[ "NO" ] ?