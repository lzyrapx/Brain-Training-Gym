{ http://progopedia.com/language/false/ }
{ https://strlen.com/false-language/ }
{ https://esolangs.org/wiki/FALSE }

{ 读函数 }
[
  0
  [
    ^ $ $ '9 > '0 @ > | ~
  ]
  [
    '0 - \ 10 * +
  ] #
  %
] n:

{ 读取数组元素个数 m }
n;! m:


{ 循环读取 m 个整数压入数据栈 }
m; i:
[ i; 0 > ]
[
  n;!
  i; 1 - i:
] #

{ 排序算法 }
m; i:
m; l:
[ i; 0 > ]
[
  i; j:
  0 k:

  [ j; 0 > ]
  [
    i; j; - k; + O
    
    k; 0 >
    [
      a: b:
      a; b;
      0 e:
      > [ 1 e: ] ?   { 比较 a 和 b 大小 }
      
      a; b;
      e; 0 = [ \ ] ? { 交换位置 }
    ] ?
    
    k; 1 + k:
    j; 1 - j:
  ] #
  
  { 输出排好序的数字及空格 }
  . " "
  
  i; 1 - i:
  l; k; + 1 - l:
] #

{ 最后要清除栈，不然会报错}
[ l; 0 > ]
[
  %
  l; 1 - l:
] #