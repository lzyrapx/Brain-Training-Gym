{ http://progopedia.com/language/false/ }
{ https://strlen.com/false-language/ }
{ https://esolangs.org/wiki/FALSE }

{ 读取整数 a }
0 a:
[
  ^ $ $
  '0 1 - > \ '9 > ~ &   { 判断字符是否在 '0'~'9' 之间 }
]
[
  '0 -
  a; 10 * + a:  { a = a * 10 + digit }
] #

{ 保存运算符到变量 o }
o:

{ 读取整数 b }
0 b:
[
  ^ $ $
  '0 1 - > \ '9 > ~ &    { 判断字符是否在 '0'~'9' 之间 }
]
[
  '0 -
  b; 10 * + b:   { b = b * 10 + digit }
] #
%   { 丢弃结束的非数字字符 }

{ 根据运算符 o 执行对应计算， 输出结果 }
{ 取模实现: a - (a / b) * b }
o; '+ = [ a; b; + . ] ?
o; '- = [ a; b; - . ] ?
o; '* = [ a; b; * . ] ?
o; '/ = [ a; b; / . ] ?
o; '% = [ a; a; b; / b; * - . ] ?